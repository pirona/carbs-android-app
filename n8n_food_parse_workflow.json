          "name": "MAstodon Le Boudoir"
        },
        "mistralCloudApi": {
          "id": "Ie7cAbsVLbsEukuQ",
          "name": "Mistral Cloud account"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "food-parse",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://hass.gyozamancave.fr"
        }
      },
      "id": "aa266073-76bc-4a85-90fc-c1543184194c",
      "name": "Webhook",
